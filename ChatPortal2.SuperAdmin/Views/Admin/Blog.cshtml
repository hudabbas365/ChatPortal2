@model List<AIInsights.Models.BlogPost>
@{
    ViewData["Title"] = "Blog";
    ViewData["ActivePage"] = "blog";
    var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
    var subscriptionPlans = ViewBag.SubscriptionPlans as List<AIInsights.SuperAdmin.Controllers.SuperAdminController.SubscriptionOptionDto>
                            ?? new List<AIInsights.SuperAdmin.Controllers.SuperAdminController.SubscriptionOptionDto>();
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">Blog Posts</h1>
        <p class="page-desc">Manage news, updates, and feature announcement posts.</p>
    </div>
    <button class="btn-primary-sm" onclick="openForm()"><i class="bi bi-plus-lg"></i>New Post</button>
</div>

<div class="card-panel">
    <div class="card-panel-title">All Posts</div>
    @if (Model.Count == 0)
    {
        <p style="color:var(--text-muted);font-size:.85rem;">No blog posts yet. Click <strong>New Post</strong> to create one.</p>
    }
    else
    {
        <table class="tbl">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Feature</th>
                    <th>Email Queue</th>
                    <th>Published</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model)
                {
                    var queued = post.AnnouncementEmailLogs.Count(l => l.Status == "Queued");
                    var sent = post.AnnouncementEmailLogs.Count(l => l.Status == "Sent");
                    var failed = post.AnnouncementEmailLogs.Count(l => l.Status == "Failed");
                    <tr>
                        <td style="font-weight:600;color:#1e3a5f;">
                            @post.Title
                            @if (!string.IsNullOrWhiteSpace(post.SeoKeywords) && post.SeoKeywords.Split(',', StringSplitOptions.RemoveEmptyEntries).Length < 15)
                            {
                                <div style="font-size:.72rem;color:#b45309;">SEO warning: fewer than 15 keywords</div>
                            }
                        </td>
                        <td>
                            @if (post.IsPublished)
                            {
                                <span class="badge-sm badge-emerald"><i class="bi bi-check-circle-fill"></i>Published</span>
                            }
                            else
                            {
                                <span class="badge-sm badge-amber"><i class="bi bi-pencil-fill"></i>Draft</span>
                            }
                        </td>
                        <td>@(post.IsFeatureAnnouncement ? "Yes" : "No")</td>
                        <td>
                            <div style="font-size:.78rem;line-height:1.35;">
                                <span>Queued: @queued</span><br />
                                <span>Sent: @sent</span><br />
                                <span>Failed: @failed</span>
                            </div>
                            @if (failed > 0)
                            {
                                <button class="btn-ghost-sm" style="margin-top:.35rem;font-size:.72rem;" onclick="resendFailed(@post.Id)">Resend failed</button>
                            }
                        </td>
                        <td>@post.PublishedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <button class="btn-ghost-sm" style="padding:.3rem .6rem;font-size:.78rem;" onclick='editPost(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(post, jsonOpts)))'><i class="bi bi-pencil"></i></button>
                            <button class="btn-ghost-sm" style="padding:.3rem .6rem;font-size:.78rem;border-color:#ef4444;color:#ef4444;" onclick="deletePost(@post.Id)"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div id="blogModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.45);align-items:center;justify-content:center;">
    <div style="background:#fff;border:1px solid var(--border);border-radius:14px;width:860px;max-width:96vw;max-height:94vh;overflow-y:auto;padding:1.5rem;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
            <h3 id="formTitle" style="font-size:1.05rem;font-weight:700;color:#1e3a5f;">New Post</h3>
            <button onclick="closeForm()" style="background:none;border:none;font-size:1.2rem;color:var(--text-muted);cursor:pointer;"><i class="bi bi-x-lg"></i></button>
        </div>

        <input type="hidden" id="postId" value="0" />

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:.75rem;">
            <div>
                <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Title</label>
                <input id="postTitle" type="text" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;" />
            </div>
            <div>
                <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Slug</label>
                <input id="postSlug" type="text" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;" />
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:.75rem;">
            <div>
                <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Author</label>
                <input id="postAuthor" type="text" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;" />
            </div>
            <div>
                <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Email Subject (optional)</label>
                <input id="postEmailSubject" type="text" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;" />
            </div>
        </div>

        <div style="margin-bottom:.75rem;">
            <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Summary</label>
            <textarea id="postSummary" rows="2" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;resize:vertical;"></textarea>
        </div>

        <div style="margin-bottom:.75rem;">
            <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Content (HTML)</label>
            <textarea id="postContent" rows="9" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;resize:vertical;"></textarea>
        </div>

        <div style="margin-bottom:.75rem;">
            <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.35rem;">Featured Image</label>
            <input id="featuredImageFile" type="file" accept=".jpg,.jpeg,.png,.webp,.gif" />
            <div id="featuredImagePreview" style="margin-top:.5rem;"></div>
        </div>

        <div style="margin-bottom:.75rem;">
            <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.35rem;">Gallery / Content Images</label>
            <input id="galleryImageFiles" type="file" accept=".jpg,.jpeg,.png,.webp,.gif" multiple />
            <div id="galleryPreview" style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.5rem;"></div>
        </div>

        <div style="margin-bottom:.85rem;">
            <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.35rem;">SEO Keywords (target: at least 15)</label>
            <div style="display:flex;gap:.45rem;flex-wrap:wrap;">
                <input id="keywordInput" type="text" placeholder="Add keyword" style="flex:1;min-width:200px;padding:.45rem .65rem;border:1px solid var(--border);border-radius:7px;font-size:.82rem;" />
                <button type="button" class="btn-ghost-sm" onclick="addKeywordFromInput()">Add</button>
                <button type="button" class="btn-primary-sm" onclick="suggestKeywords()"><i class="bi bi-stars"></i>Suggest keywords from content</button>
            </div>
            <div id="keywordsSoftWarning" style="font-size:.72rem;color:#b45309;margin-top:.4rem;display:none;"></div>
            <div id="keywordsContainer" style="display:flex;gap:.35rem;flex-wrap:wrap;margin-top:.45rem;"></div>
        </div>

        <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.5rem;">
            <input id="postPublished" type="checkbox" checked />
            <label for="postPublished" style="font-size:.85rem;color:var(--text-dim);">Published</label>
        </div>

        <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.5rem;">
            <input id="isFeatureAnnouncement" type="checkbox" onchange="toggleAnnouncementOptions()" />
            <label for="isFeatureAnnouncement" style="font-size:.85rem;color:var(--text-dim);">Feature announcement post</label>
        </div>

        <div id="announcementOptions" style="display:none;border:1px dashed #cbd5e1;border-radius:10px;padding:.75rem;margin-bottom:1rem;">
            <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.5rem;">
                <input id="sendToAllSubscribers" type="checkbox" />
                <label for="sendToAllSubscribers" style="font-size:.82rem;color:var(--text-dim);">Send to all subscribers</label>
            </div>
            <div style="font-size:.78rem;color:var(--text-muted);margin-bottom:.35rem;">Subscription plans</div>
            <div style="display:flex;flex-wrap:wrap;gap:.5rem;">
                @foreach (var plan in subscriptionPlans)
                {
                    <label style="display:inline-flex;align-items:center;gap:.3rem;font-size:.8rem;">
                        <input type="checkbox" class="subscription-plan" value="@plan.Name" /> @plan.Name
                    </label>
                }
            </div>
        </div>

        <div style="display:flex;gap:.5rem;justify-content:flex-end;">
            <button class="btn-ghost-sm" onclick="closeForm()">Cancel</button>
            <button class="btn-ghost-sm" onclick="savePost(false)">Save Draft/Publish (no email)</button>
            <button class="btn-primary-sm" onclick="savePost(true)"><i class="bi bi-send"></i>Save &amp; Send announcement email</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var editingPostId = 0;
    var subscriptionLookup = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(subscriptionPlans.ToDictionary(x => x.Id, x => x.Name)));
    var featuredImagePath = '';
    var galleryImages = [];
    var keywords = [];

    function getCsrfToken() {
        var m = document.cookie.match(/XSRF-TOKEN=([^;]+)/);
        return m ? decodeURIComponent(m[1]) : '';
    }

    function openForm() {
        editingPostId = 0;
        document.getElementById('postId').value = '0';
        document.getElementById('postTitle').value = '';
        document.getElementById('postSlug').value = '';
        document.getElementById('postAuthor').value = '';
        document.getElementById('postEmailSubject').value = '';
        document.getElementById('postSummary').value = '';
        document.getElementById('postContent').value = '';
        document.getElementById('postPublished').checked = true;
        document.getElementById('isFeatureAnnouncement').checked = false;
        document.getElementById('sendToAllSubscribers').checked = false;
        document.querySelectorAll('.subscription-plan').forEach(c => c.checked = false);
        featuredImagePath = '';
        galleryImages = [];
        keywords = [];
        renderFeatured();
        renderGallery();
        renderKeywords();
        toggleAnnouncementOptions();
        document.getElementById('formTitle').textContent = 'New Post';
        document.getElementById('blogModal').style.display = 'flex';
    }

    function editPost(post) {
        editingPostId = Number(post && post.id) || 0;
        document.getElementById('postId').value = String(editingPostId);
        document.getElementById('postTitle').value = post.title || '';
        document.getElementById('postSlug').value = post.slug || '';
        document.getElementById('postAuthor').value = post.author || '';
        document.getElementById('postEmailSubject').value = post.emailSubject || '';
        document.getElementById('postSummary').value = post.summary || '';
        document.getElementById('postContent').value = post.content || '';
        document.getElementById('postPublished').checked = !!post.isPublished;
        document.getElementById('isFeatureAnnouncement').checked = !!post.isFeatureAnnouncement;
        featuredImagePath = post.featuredImagePath || post.imageUrl || '';
        galleryImages = ((post.blogImages || []).map(x => x.imagePath).filter(Boolean));
        keywords = splitKeywords(post.seoKeywords || '');
        document.querySelectorAll('.subscription-plan').forEach(c => c.checked = false);
        var plans = (post.blogSubscriptions || [])
            .map(x => subscriptionLookup[x.subscriptionId] || null)
            .filter(Boolean);
        document.querySelectorAll('.subscription-plan').forEach(c => { if (plans.indexOf(c.value) >= 0) c.checked = true; });
        document.getElementById('sendToAllSubscribers').checked = plans.length === 0;
        renderFeatured();
        renderGallery();
        renderKeywords();
        toggleAnnouncementOptions();
        document.getElementById('formTitle').textContent = 'Edit Post';
        document.getElementById('blogModal').style.display = 'flex';
    }

    function closeForm() { document.getElementById('blogModal').style.display = 'none'; }

    function toggleAnnouncementOptions() {
        document.getElementById('announcementOptions').style.display = document.getElementById('isFeatureAnnouncement').checked ? 'block' : 'none';
    }

    function splitKeywords(raw) {
        return (raw || '')
            .split(',')
            .map(x => x.trim())
            .filter(x => !!x)
            .filter((v, i, arr) => arr.findIndex(a => a.toLowerCase() === v.toLowerCase()) === i);
    }

    function renderFeatured() {
        var box = document.getElementById('featuredImagePreview');
        if (!featuredImagePath) {
            box.innerHTML = '<span style="font-size:.75rem;color:var(--text-muted);">No featured image selected.</span>';
            return;
        }
        box.innerHTML = '<div style="display:inline-flex;align-items:center;gap:.4rem;border:1px solid var(--border);padding:.35rem;border-radius:8px;">'
            + '<img src="' + featuredImagePath + '" style="width:56px;height:56px;object-fit:cover;border-radius:6px;" />'
            + '<button type="button" class="btn-ghost-sm" onclick="removeFeatured()">Delete</button></div>';
    }

    function renderGallery() {
        var box = document.getElementById('galleryPreview');
        if (!galleryImages.length) {
            box.innerHTML = '<span style="font-size:.75rem;color:var(--text-muted);">No gallery images selected.</span>';
            return;
        }
        box.innerHTML = galleryImages.map(function(path, i) {
            return '<div style="position:relative;border:1px solid var(--border);border-radius:8px;padding:.25rem;">'
                + '<img src="' + path + '" style="width:84px;height:84px;object-fit:cover;border-radius:6px;" />'
                + '<button type="button" onclick="removeGallery(' + i + ')" style="position:absolute;top:-8px;right:-8px;border:none;background:#dc2626;color:#fff;border-radius:50%;width:20px;height:20px;font-size:11px;">×</button>'
                + '</div>';
        }).join('');
    }

    function renderKeywords() {
        var box = document.getElementById('keywordsContainer');
        box.innerHTML = keywords.map(function(k, i) {
            return '<span style="display:inline-flex;align-items:center;gap:.35rem;background:#eef2ff;color:#1e3a5f;border-radius:999px;padding:.22rem .6rem;font-size:.75rem;">'
                + escapeHtml(k)
                + '<button type="button" onclick="removeKeyword(' + i + ')" style="border:none;background:none;color:#1e3a5f;font-size:.75rem;">×</button></span>';
        }).join('');
        var warning = document.getElementById('keywordsSoftWarning');
        if (keywords.length > 0 && keywords.length < 15) {
            warning.style.display = 'block';
            warning.textContent = 'Soft warning: fewer than 15 keywords are currently set.';
        } else {
            warning.style.display = 'none';
            warning.textContent = '';
        }
    }

    function removeFeatured() { featuredImagePath = ''; renderFeatured(); }
    function removeGallery(index) { galleryImages.splice(index, 1); renderGallery(); }
    function removeKeyword(index) { keywords.splice(index, 1); renderKeywords(); }

    function addKeywordFromInput() {
        var input = document.getElementById('keywordInput');
        var value = (input.value || '').trim();
        if (!value) return;
        if (!keywords.some(k => k.toLowerCase() === value.toLowerCase())) keywords.push(value);
        input.value = '';
        renderKeywords();
    }

    async function suggestKeywords() {
        try {
            var resp = await fetch('/api/superadmin/blog/suggest-keywords', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                body: JSON.stringify({ title: document.getElementById('postTitle').value, content: document.getElementById('postContent').value })
            });
            var data = await resp.json();
            if (!resp.ok || !data.success) { alert(data.error || 'Suggestion failed'); return; }
            (data.keywords || []).forEach(function(k) {
                if (!keywords.some(x => x.toLowerCase() === String(k).toLowerCase())) keywords.push(k);
            });
            renderKeywords();
        } catch {
            alert('Suggestion failed');
        }
    }

    async function uploadFiles(files, type) {
        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            var ext = (file.name.split('.').pop() || '').toLowerCase();
            if (['jpg','jpeg','png','webp','gif'].indexOf(ext) < 0) { alert('Only JPG, JPEG, PNG, WEBP, GIF are allowed.'); continue; }
            if (file.size > 5 * 1024 * 1024) { alert('Each image must be 5 MB or less.'); continue; }

            var fd = new FormData();
            fd.append('file', file);
            fd.append('type', type);
            var resp = await fetch('/api/superadmin/images/upload', {
                method: 'POST',
                headers: { 'RequestVerificationToken': getCsrfToken() },
                body: fd
            });
            var data = await resp.json();
            if (!resp.ok || !data.success) { alert(data.error || 'Upload failed'); continue; }
            if (type === 'blog-featured') {
                featuredImagePath = data.imagePath;
                renderFeatured();
            } else {
                galleryImages.push(data.imagePath);
                renderGallery();
            }
        }
    }

    document.getElementById('featuredImageFile').addEventListener('change', function(e) {
        uploadFiles(e.target.files || [], 'blog-featured');
        e.target.value = '';
    });

    document.getElementById('galleryImageFiles').addEventListener('change', function(e) {
        uploadFiles(e.target.files || [], 'blog');
        e.target.value = '';
    });

    async function savePost(sendEmail) {
        var selectedPlans = Array.from(document.querySelectorAll('.subscription-plan:checked')).map(c => c.value);
        var payload = {
            id: editingPostId,
            title: document.getElementById('postTitle').value,
            slug: document.getElementById('postSlug').value,
            summary: document.getElementById('postSummary').value,
            content: document.getElementById('postContent').value,
            author: document.getElementById('postAuthor').value,
            imageUrl: featuredImagePath || null,
            featuredImagePath: featuredImagePath || null,
            galleryImages: galleryImages,
            seoKeywords: keywords.join(', '),
            isFeatureAnnouncement: document.getElementById('isFeatureAnnouncement').checked,
            emailSubject: document.getElementById('postEmailSubject').value,
            sendToAllSubscribers: document.getElementById('sendToAllSubscribers').checked,
            selectedSubscriptionPlans: selectedPlans,
            sendAnnouncementEmail: !!sendEmail,
            isPublished: document.getElementById('postPublished').checked
        };

        if (!payload.title || !payload.title.trim()) { alert('Title is required.'); return; }

        if (sendEmail && payload.isFeatureAnnouncement && payload.isPublished) {
            var previewResp = await fetch('/api/superadmin/blog/announcement/preview', {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                body: JSON.stringify({ blogId: editingPostId || 0, sendToAllSubscribers: payload.sendToAllSubscribers, selectedSubscriptionPlans: selectedPlans })
            });
            if (previewResp.ok) {
                var preview = await previewResp.json();
                var count = preview.recipientCount || 0;
                if (!confirm('Send announcement email to ' + count + ' recipient(s)?')) return;
            }
        }

        fetch('/api/superadmin/blog/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        }).then(r => r.json()).then(d => {
            if (d.success) {
                if (d.warning) alert(d.warning);
                location.reload();
            } else alert(d.error || 'Save failed');
        }).catch(() => alert('Save failed'));
    }

    function resendFailed(id) {
        fetch('/api/superadmin/blog/' + id + '/announcement/resend-failed', {
            method: 'POST',
            headers: { 'RequestVerificationToken': getCsrfToken() }
        })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    alert('Queued ' + (d.queued || 0) + ' failed email(s).');
                    location.reload();
                } else {
                    alert(d.error || 'Resend failed');
                }
            })
            .catch(() => alert('Resend failed'));
    }

    function deletePost(id) {
        if (!confirm('Delete this blog post?')) return;
        fetch('/api/superadmin/blog/' + id, { method: 'DELETE' })
            .then(r => r.json()).then(d => { if (d.success) location.reload(); else alert(d.error || 'Delete failed'); })
            .catch(() => alert('Delete failed'));
    }

    function escapeHtml(s) {
        return (s || '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    }
</script>
}
