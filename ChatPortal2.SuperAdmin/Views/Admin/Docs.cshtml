@model List<AIInsights.Models.DocArticle>
@{
    ViewData["Title"] = "Documentation";
    ViewData["ActivePage"] = "docs";
    var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">Documentation</h1>
        <p class="page-desc">Manage help articles and project documentation.</p>
    </div>
    <button class="btn-primary-sm" onclick="openForm()"><i class="bi bi-plus-lg"></i>New Article</button>
</div>

<div class="card-panel">
    <div class="card-panel-title">All Articles</div>
    @if (Model.Count == 0)
    {
        <p style="color:var(--text-muted);font-size:.85rem;">No documentation articles yet.</p>
    }
    else
    {
        <table class="tbl">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in Model)
                {
                    <tr>
                        <td>@doc.SortOrder</td>
                        <td style="font-weight:600;color:#1e3a5f;">@doc.Title</td>
                        <td>
                            @if (doc.IsPublished)
                            {
                                <span class="badge-sm badge-emerald"><i class="bi bi-check-circle-fill"></i>Published</span>
                            }
                            else
                            {
                                <span class="badge-sm badge-amber"><i class="bi bi-pencil-fill"></i>Draft</span>
                            }
                        </td>
                        <td>@doc.UpdatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <button class="btn-ghost-sm" style="padding:.3rem .6rem;font-size:.78rem;" onclick='editDoc(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(doc, jsonOpts)))'><i class="bi bi-pencil"></i></button>
                            <button class="btn-ghost-sm" style="padding:.3rem .6rem;font-size:.78rem;border-color:#ef4444;color:#ef4444;" onclick="deleteDoc(@doc.Id)"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div id="docModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.45);align-items:center;justify-content:center;">
    <div style="background:#fff;border:1px solid var(--border);border-radius:14px;width:820px;max-width:96vw;max-height:94vh;overflow-y:auto;padding:1.5rem;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
            <h3 id="formTitle" style="font-size:1.05rem;font-weight:700;color:#1e3a5f;">New Article</h3>
            <button onclick="closeForm()" style="background:none;border:none;font-size:1.2rem;color:var(--text-muted);cursor:pointer;"><i class="bi bi-x-lg"></i></button>
        </div>

        <input type="hidden" id="docId" value="0" />

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:.75rem;">
            <div>
                <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Title</label>
                <input id="docTitle" type="text" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;" />
            </div>
            <div>
                <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Slug</label>
                <input id="docSlug" type="text" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;" />
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 120px;gap:.75rem;margin-bottom:.75rem;">
            <div>
                <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Author</label>
                <input id="docAuthor" type="text" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;" />
            </div>
            <div>
                <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Sort Order</label>
                <input id="docOrder" type="number" value="0" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;" />
            </div>
        </div>

        <div style="margin-bottom:.75rem;">
            <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Summary</label>
            <textarea id="docSummary" rows="2" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;resize:vertical;"></textarea>
        </div>

        <div style="margin-bottom:.75rem;">
            <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Content (HTML)</label>
            <textarea id="docContent" rows="9" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;resize:vertical;"></textarea>
        </div>

        <div style="margin-bottom:.75rem;">
            <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.35rem;">Featured Image</label>
            <input id="docFeaturedImageFile" type="file" accept=".jpg,.jpeg,.png,.webp,.gif" />
            <div id="docFeaturedPreview" style="margin-top:.5rem;"></div>
        </div>

        <div style="margin-bottom:.75rem;">
            <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.35rem;">Gallery / Content Images</label>
            <input id="docGalleryImageFiles" type="file" accept=".jpg,.jpeg,.png,.webp,.gif" multiple />
            <div id="docGalleryPreview" style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.5rem;"></div>
        </div>

        <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:1rem;">
            <input id="docPublished" type="checkbox" checked />
            <label for="docPublished" style="font-size:.85rem;color:var(--text-dim);">Published</label>
        </div>

        <div style="display:flex;gap:.5rem;justify-content:flex-end;">
            <button class="btn-ghost-sm" onclick="closeForm()">Cancel</button>
            <button class="btn-primary-sm" onclick="saveDoc()"><i class="bi bi-check-lg"></i>Save Article</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var editingDocId = 0;
    var featuredImagePath = '';
    var galleryImages = [];

    function getCsrfToken() {
        var m = document.cookie.match(/XSRF-TOKEN=([^;]+)/);
        return m ? decodeURIComponent(m[1]) : '';
    }

    function openForm() {
        editingDocId = 0;
        document.getElementById('docId').value = '0';
        document.getElementById('docTitle').value = '';
        document.getElementById('docSlug').value = '';
        document.getElementById('docAuthor').value = '';
        document.getElementById('docOrder').value = '0';
        document.getElementById('docSummary').value = '';
        document.getElementById('docContent').value = '';
        document.getElementById('docPublished').checked = true;
        featuredImagePath = '';
        galleryImages = [];
        renderFeatured();
        renderGallery();
        document.getElementById('formTitle').textContent = 'New Article';
        document.getElementById('docModal').style.display = 'flex';
    }

    function editDoc(doc) {
        editingDocId = Number(doc && doc.id) || 0;
        document.getElementById('docId').value = String(editingDocId);
        document.getElementById('docTitle').value = doc.title || '';
        document.getElementById('docSlug').value = doc.slug || '';
        document.getElementById('docAuthor').value = doc.author || '';
        document.getElementById('docOrder').value = String(doc.sortOrder || 0);
        document.getElementById('docSummary').value = doc.summary || '';
        document.getElementById('docContent').value = doc.content || '';
        document.getElementById('docPublished').checked = !!doc.isPublished;
        featuredImagePath = doc.featuredImagePath || '';
        galleryImages = ((doc.documentImages || []).map(x => x.imagePath).filter(Boolean));
        renderFeatured();
        renderGallery();
        document.getElementById('formTitle').textContent = 'Edit Article';
        document.getElementById('docModal').style.display = 'flex';
    }

    function closeForm() { document.getElementById('docModal').style.display = 'none'; }

    function renderFeatured() {
        var box = document.getElementById('docFeaturedPreview');
        if (!featuredImagePath) {
            box.innerHTML = '<span style="font-size:.75rem;color:var(--text-muted);">No featured image selected.</span>';
            return;
        }
        box.innerHTML = '<div style="display:inline-flex;align-items:center;gap:.4rem;border:1px solid var(--border);padding:.35rem;border-radius:8px;">'
            + '<img src="' + featuredImagePath + '" style="width:56px;height:56px;object-fit:cover;border-radius:6px;" />'
            + '<button type="button" class="btn-ghost-sm" onclick="featuredImagePath=\'\';renderFeatured();">Delete</button></div>';
    }

    function renderGallery() {
        var box = document.getElementById('docGalleryPreview');
        if (!galleryImages.length) {
            box.innerHTML = '<span style="font-size:.75rem;color:var(--text-muted);">No gallery images selected.</span>';
            return;
        }
        box.innerHTML = galleryImages.map(function(path, i) {
            return '<div style="position:relative;border:1px solid var(--border);border-radius:8px;padding:.25rem;">'
                + '<img src="' + path + '" style="width:84px;height:84px;object-fit:cover;border-radius:6px;" />'
                + '<button type="button" onclick="removeGallery(' + i + ')" style="position:absolute;top:-8px;right:-8px;border:none;background:#dc2626;color:#fff;border-radius:50%;width:20px;height:20px;font-size:11px;">×</button>'
                + '</div>';
        }).join('');
    }

    function removeGallery(index) { galleryImages.splice(index, 1); renderGallery(); }

    async function uploadFiles(files, type) {
        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            var ext = (file.name.split('.').pop() || '').toLowerCase();
            if (['jpg','jpeg','png','webp','gif'].indexOf(ext) < 0) { alert('Only JPG, JPEG, PNG, WEBP, GIF are allowed.'); continue; }
            if (file.size > 5 * 1024 * 1024) { alert('Each image must be 5 MB or less.'); continue; }

            var fd = new FormData();
            fd.append('file', file);
            fd.append('type', type);
            var resp = await fetch('/api/superadmin/images/upload', {
                method: 'POST',
                headers: { 'RequestVerificationToken': getCsrfToken() },
                body: fd
            });
            var data = await resp.json();
            if (!resp.ok || !data.success) { alert(data.error || 'Upload failed'); continue; }
            if (type === 'document-featured') {
                featuredImagePath = data.imagePath;
                renderFeatured();
            } else {
                galleryImages.push(data.imagePath);
                renderGallery();
            }
        }
    }

    document.getElementById('docFeaturedImageFile').addEventListener('change', function(e) {
        uploadFiles(e.target.files || [], 'document-featured');
        e.target.value = '';
    });

    document.getElementById('docGalleryImageFiles').addEventListener('change', function(e) {
        uploadFiles(e.target.files || [], 'document');
        e.target.value = '';
    });

    function saveDoc() {
        var payload = {
            id: editingDocId,
            title: document.getElementById('docTitle').value,
            slug: document.getElementById('docSlug').value,
            summary: document.getElementById('docSummary').value,
            content: document.getElementById('docContent').value,
            author: document.getElementById('docAuthor').value,
            featuredImagePath: featuredImagePath || null,
            galleryImages: galleryImages,
            sortOrder: parseInt(document.getElementById('docOrder').value) || 0,
            isPublished: document.getElementById('docPublished').checked
        };
        fetch('/api/superadmin/docs/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        }).then(r => r.json()).then(d => {
            if (d.success) location.reload();
            else alert(d.error || 'Save failed');
        }).catch(() => alert('Save failed'));
    }

    function deleteDoc(id) {
        if (!confirm('Delete this article?')) return;
        fetch('/api/superadmin/docs/' + id, { method: 'DELETE' })
            .then(r => r.json()).then(d => { if (d.success) location.reload(); else alert(d.error || 'Delete failed'); })
            .catch(() => alert('Delete failed'));
    }
</script>
}
