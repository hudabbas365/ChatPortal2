@model List<AIInsights.Models.DocArticle>
@{
    ViewData["Title"] = "Documentation";
    ViewData["ActivePage"] = "docs";
    var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
    var docsJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(doc => new
    {
        doc.Id,
        doc.Title,
        doc.Slug,
        doc.Summary,
        doc.Content,
        doc.Author,
        doc.SortOrder,
        doc.IsPublished,
        doc.FeaturedImagePath,
        GalleryImages = doc.DocumentImages.OrderBy(i => i.SortOrder).Select(i => new { i.Id, i.ImagePath, i.SortOrder, i.AltText })
    }), jsonOpts));
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">Documentation</h1>
        <p class="page-desc">Manage documentation content, featured images, and gallery assets.</p>
    </div>
    <button class="btn-primary-sm" onclick="openForm()"><i class="bi bi-plus-lg"></i>New Article</button>
</div>

<div class="card-panel">
    <div class="card-panel-title">All Articles</div>
    @if (Model.Count == 0)
    {
        <p style="color:var(--text-muted);font-size:.85rem;">No documentation articles yet. Click <strong>New Article</strong> to create one.</p>
    }
    else
    {
        <table class="tbl">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Images</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var doc in Model)
            {
                <tr>
                    <td>@doc.SortOrder</td>
                    <td>
                        <div style="font-weight:600;color:#1e3a5f;">@doc.Title</div>
                        <div style="font-size:.73rem;color:var(--text-muted);"><code>@doc.Slug</code></div>
                    </td>
                    <td>
                        @if (doc.IsPublished)
                        {
                            <span class="badge-sm badge-emerald"><i class="bi bi-check-circle-fill"></i>Published</span>
                        }
                        else
                        {
                            <span class="badge-sm badge-amber"><i class="bi bi-pencil-fill"></i>Draft</span>
                        }
                    </td>
                    <td>
                        <div style="font-size:.78rem;color:var(--text-dim);">Featured: @(string.IsNullOrWhiteSpace(doc.FeaturedImagePath) ? "No" : "Yes")</div>
                        <div style="font-size:.78rem;color:var(--text-muted);">Gallery: @doc.DocumentImages.Count</div>
                    </td>
                    <td>
                        <button class="btn-ghost-sm" style="padding:.3rem .6rem;font-size:.78rem;" onclick="editDoc(@doc.Id)"><i class="bi bi-pencil"></i></button>
                        <button class="btn-ghost-sm" style="padding:.3rem .6rem;font-size:.78rem;border-color:#ef4444;color:#ef4444;" onclick="deleteDoc(@doc.Id)"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div id="docModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.45);align-items:center;justify-content:center;padding:1rem;">
    <div style="background:#fff;border:1px solid var(--border);border-radius:14px;width:940px;max-width:96vw;max-height:92vh;overflow-y:auto;padding:1.75rem;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;">
            <h3 id="formTitle" style="font-size:1.05rem;font-weight:700;color:#1e3a5f;">New Article</h3>
            <button onclick="closeForm()" style="background:none;border:none;font-size:1.2rem;color:var(--text-muted);cursor:pointer;"><i class="bi bi-x-lg"></i></button>
        </div>
        <div id="docFormAlert" style="display:none;margin-bottom:1rem;padding:.7rem .85rem;border-radius:10px;font-size:.82rem;"></div>
        <input type="hidden" id="docId" value="0" />

        <div style="display:grid;grid-template-columns:1.2fr .8fr;gap:1rem;align-items:start;">
            <div>
                <div style="margin-bottom:.85rem;">
                    <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Title</label>
                    <input id="docTitle" type="text" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;" placeholder="Getting Started" />
                </div>
                <div style="display:flex;gap:.75rem;margin-bottom:.85rem;">
                    <div style="flex:1;">
                        <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Slug</label>
                        <input id="docSlug" type="text" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;" placeholder="getting-started" />
                    </div>
                    <div style="width:130px;">
                        <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Sort Order</label>
                        <input id="docOrder" type="number" value="0" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;" />
                    </div>
                </div>
                <div style="margin-bottom:.85rem;">
                    <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Author</label>
                    <input id="docAuthor" type="text" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;" placeholder="Admin" />
                </div>
                <div style="margin-bottom:.85rem;">
                    <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Summary</label>
                    <textarea id="docSummary" rows="2" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;resize:vertical;" placeholder="Brief summary..."></textarea>
                </div>
                <div style="margin-bottom:.85rem;">
                    <label style="font-size:.78rem;font-weight:600;color:var(--text-muted);display:block;margin-bottom:.3rem;">Content (HTML or Markdown)</label>
                    <textarea id="docContent" rows="12" style="width:100%;padding:.5rem .75rem;border:1px solid var(--border);border-radius:8px;font-size:.85rem;resize:vertical;" placeholder="Full article content..."></textarea>
                </div>
                <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:1rem;">
                    <input id="docPublished" type="checkbox" checked />
                    <label for="docPublished" style="font-size:.85rem;font-weight:500;color:var(--text-dim);">Published</label>
                </div>
            </div>
            <div>
                <div class="card-panel" style="padding:1rem;margin-bottom:1rem;">
                    <div class="card-panel-title" style="margin-bottom:.7rem;">Featured Image</div>
                    <input id="docFeaturedInput" type="file" accept=".jpg,.jpeg,.png,.webp,.gif,image/*" style="display:block;margin-bottom:.6rem;font-size:.8rem;" />
                    <div id="docFeaturedPreview"></div>
                </div>
                <div class="card-panel" style="padding:1rem;">
                    <div class="card-panel-title" style="margin-bottom:.7rem;">Gallery / Content Images</div>
                    <input id="docGalleryInput" type="file" multiple accept=".jpg,.jpeg,.png,.webp,.gif,image/*" style="display:block;margin-bottom:.6rem;font-size:.8rem;" />
                    <div id="docGalleryList" style="display:flex;flex-direction:column;gap:.75rem;"></div>
                </div>
            </div>
        </div>

        <div style="display:flex;gap:.5rem;justify-content:flex-end;margin-top:1rem;">
            <button class="btn-ghost-sm" onclick="closeForm()">Cancel</button>
            <button class="btn-primary-sm" onclick="saveDoc()"><i class="bi bi-check-lg"></i>Save Article</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
const docs = @docsJson;
let editingDoc = null;
let docFeaturedImageState = null;
let docGalleryImages = [];

function openForm() {
    editingDoc = null;
    document.getElementById('docId').value = '0';
    document.getElementById('docTitle').value = '';
    document.getElementById('docSlug').value = '';
    document.getElementById('docAuthor').value = '';
    document.getElementById('docOrder').value = '0';
    document.getElementById('docSummary').value = '';
    document.getElementById('docContent').value = '';
    document.getElementById('docPublished').checked = true;
    docFeaturedImageState = null;
    docGalleryImages = [];
    renderDocFeaturedImage();
    renderDocGalleryImages();
    setDocAlert();
    document.getElementById('formTitle').textContent = 'New Article';
    document.getElementById('docModal').style.display = 'flex';
}

function editDoc(id) {
    const doc = docs.find(item => item.id === id);
    if (!doc) return;
    editingDoc = doc;
    document.getElementById('docId').value = String(doc.id);
    document.getElementById('docTitle').value = doc.title || '';
    document.getElementById('docSlug').value = doc.slug || '';
    document.getElementById('docAuthor').value = doc.author || '';
    document.getElementById('docOrder').value = String(doc.sortOrder || 0);
    document.getElementById('docSummary').value = doc.summary || '';
    document.getElementById('docContent').value = doc.content || '';
    document.getElementById('docPublished').checked = !!doc.isPublished;
    docFeaturedImageState = doc.featuredImagePath ? { imagePath: doc.featuredImagePath, existing: true } : null;
    docGalleryImages = (doc.galleryImages || []).map(item => ({ id: item.id, imagePath: item.imagePath, sortOrder: item.sortOrder, altText: item.altText || '', existing: true }));
    renderDocFeaturedImage();
    renderDocGalleryImages();
    setDocAlert();
    document.getElementById('formTitle').textContent = 'Edit Article';
    document.getElementById('docModal').style.display = 'flex';
}

function closeForm() { document.getElementById('docModal').style.display = 'none'; }

function setDocAlert(message, type) {
    const alert = document.getElementById('docFormAlert');
    if (!message) { alert.style.display = 'none'; alert.textContent = ''; return; }
    alert.style.display = 'block';
    alert.textContent = message;
    alert.style.background = type === 'error' ? '#fef2f2' : '#eff6ff';
    alert.style.color = type === 'error' ? '#b91c1c' : '#1d4ed8';
    alert.style.border = `1px solid ${type === 'error' ? '#fecaca' : '#bfdbfe'}`;
}

function renderDocFeaturedImage() {
    const target = document.getElementById('docFeaturedPreview');
    if (!docFeaturedImageState || !docFeaturedImageState.imagePath) {
        target.innerHTML = '<div style="font-size:.78rem;color:var(--text-muted);">No featured image selected.</div>';
        return;
    }
    target.innerHTML = `<div style="border:1px solid var(--border);border-radius:10px;padding:.6rem;"><img src="${escapeHtml(docFeaturedImageState.imagePath)}" alt="Featured preview" style="display:block;width:100%;max-height:200px;object-fit:cover;border-radius:8px;" /><div style="margin-top:.45rem;display:flex;justify-content:flex-end;"><button type="button" class="btn-ghost-sm" style="padding:.3rem .55rem;" onclick="removeDocFeaturedImage()"><i class="bi bi-trash"></i></button></div></div>`;
}

function removeDocFeaturedImage() { docFeaturedImageState = { fileName: '', base64Data: '' }; renderDocFeaturedImage(); }

function renderDocGalleryImages() {
    const target = document.getElementById('docGalleryList');
    if (!docGalleryImages.length) {
        target.innerHTML = '<div style="font-size:.78rem;color:var(--text-muted);">No gallery images yet.</div>';
        return;
    }
    target.innerHTML = docGalleryImages.map((image, index) => `
        <div style="border:1px solid var(--border);border-radius:10px;padding:.65rem;display:grid;grid-template-columns:88px 1fr auto;gap:.75rem;align-items:start;">
            <img src="${escapeHtml(image.imagePath || '')}" alt="Gallery preview" style="width:88px;height:88px;object-fit:cover;border-radius:8px;" />
            <div>
                <input type="text" value="${escapeHtml(image.altText || '')}" placeholder="Alt text" onchange="updateDocGalleryAlt(${index}, this.value)" style="width:100%;padding:.45rem .6rem;border:1px solid var(--border);border-radius:8px;font-size:.8rem;margin-bottom:.45rem;" />
                <code style="font-size:.68rem;color:#4a8ec9;display:block;overflow-wrap:anywhere;">${escapeHtml(image.imagePath || '')}</code>
            </div>
            <button type="button" class="btn-ghost-sm" style="padding:.3rem .55rem;border-color:#ef4444;color:#ef4444;" onclick="removeDocGalleryImage(${index})"><i class="bi bi-trash"></i></button>
        </div>`).join('');
}

function updateDocGalleryAlt(index, value) { docGalleryImages[index].altText = value; }
function removeDocGalleryImage(index) { docGalleryImages.splice(index, 1); renderDocGalleryImages(); }

async function saveDoc() {
    const payload = {
        id: Number(document.getElementById('docId').value || '0'),
        title: document.getElementById('docTitle').value,
        slug: document.getElementById('docSlug').value,
        summary: document.getElementById('docSummary').value,
        content: document.getElementById('docContent').value,
        author: document.getElementById('docAuthor').value,
        sortOrder: Number(document.getElementById('docOrder').value || '0'),
        isPublished: document.getElementById('docPublished').checked,
        featuredImage: docFeaturedImageState && docFeaturedImageState.existing ? null : docFeaturedImageState,
        galleryImages: docGalleryImages.map((image, index) => ({ id: image.id || null, imagePath: image.imagePath || null, altText: image.altText || '', sortOrder: index, upload: image.existing ? null : image.upload }))
    };
    const response = await fetch('/api/superadmin/docs/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    });
    const result = await response.json();
    if (!response.ok || !result.success) { setDocAlert(result.error || 'Save failed.', 'error'); return; }
    location.reload();
}

function deleteDoc(id) {
    if (!confirm('Delete this article?')) return;
    fetch('/api/superadmin/docs/' + id, { method: 'DELETE' })
        .then(r => r.json())
        .then(d => { if (d.success) location.reload(); else setDocAlert(d.error || 'Delete failed.', 'error'); });
}

function escapeHtml(value) {
    return (value || '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
}

async function readFileAsDataUrl(file) {
    return await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = event => resolve(event.target.result);
        reader.onerror = reject;
        reader.readAsDataURL(file);
    });
}

document.getElementById('docFeaturedInput').addEventListener('change', async event => {
    const file = event.target.files && event.target.files[0];
    if (!file) return;
    const dataUrl = await readFileAsDataUrl(file);
    docFeaturedImageState = { fileName: file.name, contentType: file.type, base64Data: dataUrl, imagePath: dataUrl };
    renderDocFeaturedImage();
});

document.getElementById('docGalleryInput').addEventListener('change', async event => {
    const files = Array.from(event.target.files || []);
    for (const file of files) {
        const dataUrl = await readFileAsDataUrl(file);
        docGalleryImages.push({ imagePath: dataUrl, altText: '', upload: { fileName: file.name, contentType: file.type, base64Data: dataUrl } });
    }
    renderDocGalleryImages();
    event.target.value = '';
});
</script>
}
