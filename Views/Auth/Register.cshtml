@{
    ViewData["Title"] = "Create Account";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center min-vh-100 align-items-center">
            <div class="col-md-5">
                <div class="auth-card glass-card">
                    <div class="auth-header text-center mb-4">
                        <div class="auth-logo">
                            <i class="bi bi-bar-chart-fill"></i>
                        </div>
                        <h2 class="auth-title">Create your account</h2>
                        <p class="auth-subtitle">Start your 30-day free trial — no credit card required</p>
                    </div>
                    <div id="regAlert" class="alert d-none"></div>
                    <form id="registerForm">
                        <div class="mb-3">
                            <label class="form-label-cp">Full Name</label>
                            <div class="input-group-cp">
                                <i class="bi bi-person input-icon"></i>
                                <input type="text" class="form-control cp-input" id="regName" placeholder="John Smith" required autocomplete="off" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label-cp">Organization Name</label>
                            <div class="input-group-cp">
                                <i class="bi bi-building input-icon"></i>
                                <input type="text" class="form-control cp-input" id="regOrgName" placeholder="Acme Corp" required autocomplete="off" />
                            </div>
                            <div id="regOrgNameHint" class="form-text mt-1" style="font-size:0.78rem;min-height:1.1em"></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label-cp">Email Address</label>
                            <div class="input-group-cp">
                                <i class="bi bi-envelope input-icon"></i>
                                <input type="email" class="form-control cp-input" id="regEmail" placeholder="you@example.com" required autocomplete="off" />
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label-cp">Password</label>
                            <div class="input-group-cp">
                                <i class="bi bi-lock input-icon"></i>
                                <input type="password" class="form-control cp-input" id="regPassword" placeholder="At least 8 characters" required minlength="8" autocomplete="new-password" />
                            </div>
                        </div>
                        <button type="submit" class="btn cp-btn-gradient w-100 btn-lg" id="regBtn">
                            <i class="bi bi-rocket-takeoff me-2"></i>Create Account &amp; Start Trial
                        </button>
                    </form>
                    <div class="auth-footer mt-4 text-center">
                        <p>Already have an account? <a href="/auth/login" class="auth-link">Sign in</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// Live organization-name availability check (debounced).
let _orgNameCheckTimer = null;
let _orgNameAvailable = null; // null=unknown, true=ok, false=taken
$('#regOrgName').on('input', function() {
    const val = $(this).val().trim();
    const hint = $('#regOrgNameHint');
    _orgNameAvailable = null;
    if (_orgNameCheckTimer) clearTimeout(_orgNameCheckTimer);
    if (!val) { hint.text('').css('color', ''); return; }
    if (val.length < 2) { hint.text('Organization name is too short.').css('color', '#dc3545'); return; }
    hint.text('Checking availability…').css('color', '#6c757d');
    _orgNameCheckTimer = setTimeout(function() {
        $.getJSON('/api/auth/organization-name-available', { name: val })
            .done(function(r) {
                if ($('#regOrgName').val().trim() !== val) return; // stale
                _orgNameAvailable = !!r.available;
                if (r.available) {
                    hint.html('<i class="bi bi-check-circle-fill me-1"></i>Available').css('color', '#198754');
                } else {
                    hint.html('<i class="bi bi-x-circle-fill me-1"></i>' + (r.message || 'Not available')).css('color', '#dc3545');
                }
            })
            .fail(function() { hint.text('').css('color', ''); });
    }, 400);
});

$('#registerForm').on('submit', function(e) {
    e.preventDefault();
    if (_orgNameAvailable === false) {
        $('#regAlert').removeClass('d-none alert-success').addClass('alert alert-danger')
            .text('Please choose a different organization name.');
        $('#regOrgName').focus();
        return;
    }
    const btn = $('#regBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Creating account...');
    $.ajax({
        url: '/api/auth/register',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ email: $('#regEmail').val(), password: $('#regPassword').val(), fullName: $('#regName').val(), organizationName: $('#regOrgName').val() }),
        success: function(r) {
            localStorage.setItem('cp_user', JSON.stringify(r.user));
            localStorage.setItem('cp_token', r.token);
            window.location.href = '/chat';
        },
        error: function(e) {
            const err = e.responseJSON || {};
            $('#regAlert').removeClass('d-none alert-success').addClass('alert alert-danger').text(err.error || 'Registration failed.');
            if (err.field === 'organizationName') {
                _orgNameAvailable = false;
                $('#regOrgNameHint').html('<i class="bi bi-x-circle-fill me-1"></i>' + err.error).css('color', '#dc3545');
                $('#regOrgName').focus();
            }
            btn.prop('disabled', false).html('<i class="bi bi-rocket-takeoff me-2"></i>Create Account & Start Trial');
        }
    });
});
</script>
}
